# Copy to .env and fill in when you have the Brevo account details.
# The sender email must be a verified sender in Brevo.

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BOIT Global

# Operations inbox that receives the filled-in contact details.
# The person who submitted the form also gets a thank-you at the email they entered.
BREVO_RECIPIENT_EMAIL=hr.operations@boitglobal.com

PORT=3001

# Comma-separated browser origins allowed to call the API directly.
# Not required for local Vite, which proxies /api to this server.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
